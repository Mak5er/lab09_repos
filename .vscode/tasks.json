{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Tests",
            "type": "shell",
            "command": "make tests",
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Build Labs",
            "type": "shell",
            "command": "make labs",
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Run Tests",
            "type": "shell",
            "command": "make test",
            "dependsOn": [
                "Build Tests"
            ],
            "group": "test",
            "problemMatcher": []
        },
        {
            "type": "cppbuild",
            "label": "C/C++: clang++ build Lab_09_1 (multi-module)",
            "command": "/usr/bin/clang++",
            "args": [
                "-std=c++17",
                "-Wall",
                "-Wextra",
                "-g",
                "${workspaceFolder}/Lab_09_1/Lab_09_1.cpp",
                "${workspaceFolder}/Lab_09_1/var.cpp",
                "${workspaceFolder}/Lab_09_1/dod.cpp",
                "${workspaceFolder}/Lab_09_1/sum.cpp",
                "-o",
                "${workspaceFolder}/Lab_09_1/Lab_09_1"
            ],
            "options": {
                "cwd": "${workspaceFolder}/Lab_09_1"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "Builds all modules of Lab_09_1 (Lab_09_1.cpp, var.cpp, dod.cpp, sum.cpp)."
        },
        {
            "type": "shell",
            "label": "C/C++: clang++ build active file",
            "command": "if [[ \"${fileDirname}\" == */tests ]]; then make -C \"${workspaceFolder}\" \"tests/${fileBasenameNoExtension}\"; else /usr/bin/clang++ -std=c++17 -Wall -Wextra -g \"${fileDirname}\"/*.cpp -o \"${fileDirname}/${fileBasenameNoExtension}\"; fi",
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Builds active multi-module Lab_09 directory or unit test target."
        },
        {
            "type": "cppbuild",
            "label": "C/C++: clang++ build single file (9.2.1 / 9.2.2)",
            "command": "/usr/bin/clang++",
            "args": [
                "-std=c++17",
                "-Wall",
                "-Wextra",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "Single-file cppbuild task for Lab_09_2_1 and Lab_09_2_2."
        }
    ]
}
